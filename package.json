{
  "name": "elysia-production-template",
  "version": "1.0.0",
  "description": "Production-ready Elysia.js backend template with Bun",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun ./dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bunx @biomejs/biome check ./src",
    "lint:fix": "bunx @biomejs/biome check --apply ./src",
    "format": "bunx @biomejs/biome format --write ./src",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.1",
    "@elysiajs/openapi": "^1.4.11",
    "@prisma/client": "6.19",
    "@types/node": "^24.10.1",
    "elysia": "^1.4.16",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.3",
    "bun-types": "^1.1.34",
    "dotenv": "^17.2.3"
  },
  "keywords": [
    "elysia",
    "bun",
    "backend",
    "api",
    "typescript",
    "template"
  ],
  "author": "",
  "license": "MIT"
}
